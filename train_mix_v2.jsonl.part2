rvice.launch_type != launch_type:\n  1349\t                continue\n  1350\t\n  1351\t            service_arns.append(service.arn)\n  1352\t\n  1353\t        return sorted(service_arns)\n  1354\t\n  1355\t    def describe_services(self, cluster_str, service_names_or_arns):\n  1356\t        cluster = self._get_cluster(cluster_str)\n  1357\t        service_names = [name.split(\"/\")[-1] for name in service_names_or_arns]\n  1358\t\n  1359\t        result = []\n  1360\t        failures = []"}, {"role": "assistant", "content": "I can see that the issue is in the `list_services` method. Currently, it doesn't validate if the cluster exists before listing services. Let me check how clusters are validated in other methods:\n<|tool_call|>{\"name\": \"run_command\", \"arguments\": {\"command\": \"grep -n \\\"_get_cluster\\\" /workspace/getmoto__moto__4.1/moto/ecs/models.py\"}}<|tool_call_end|>"}, {"role": "user", "content": "EXECUTION RESULT of [execute_bash]:\ngrep -n \"_get_cluster\" /workspace/getmoto__moto__4.1/moto/ecs/models.py\r\n811:    def _get_cluster(self, name):\r\n926:        cluster = self._get_cluster(cluster_str)\r\n1015:        cluster = self._get_cluster(cluster_str)\r\n1148:        cluster = self._get_cluster(cluster_str)\r\n1186:        self._get_cluster(cluster_str)\r\n1221:            cluster = self._get_cluster(cluster_str)\r\n1262:        cluster = self._get_cluster(cluster_str)\r\n1284:        cluster = self._get_cluster(cluster_str)\r\n1305:        cluster = self._get_cluster(cluster_str)\r\n1356:        cluster = self._get_cluster(cluster_str)\r\n1376:        cluster = self._get_cluster(cluster_str)\r\n1393:        cluster = self._get_cluster(cluster_name)\r\n1437:        cluster = self._get_cluster(cluster_str)\r\n1465:        cluster = self._get_cluster(cluster_str)\r\n1520:        cluster = self._get_cluster(cluster_str)\r\n1543:        self._get_cluster(cluster_str)\r\n1548:        cluster = self._get_cluster(cluster_name)\r\n1634:        clust