`\r\n\r\nWhen trying to use a `pydantic.v1` model with FastAPI, an error is raised."}, {"role": "assistant", "content": "Applying the fix in fastapi/dependencies/utils.py (hunk at line 428).\n<|tool_call|>{\"name\": \"edit_file\", \"arguments\": {\"path\": \"fastapi/dependencies/utils.py\", \"old_text\": \"        )\\n        depends = value\\n    # Get FieldInfo from default value\\n    elif isinstance(value, (FieldInfo, may_v1.FieldInfo)):\\n        assert field_info is None, (\\n            \\\"Cannot specify FastAPI annotations in `Annotated` and default value\\\"\\n            f\\\" together for {param_name!r}\\\"\", \"new_text\": \"        )\\n        depends = value\\n    # Get FieldInfo from default value\\n    elif isinstance(value, FieldInfo):\\n        assert field_info is None, (\\n            \\\"Cannot specify FastAPI annotations in `Annotated` and default value\\\"\\n            f\\\" together for {param_name!r}\\\"\"}}<|tool_call_end|>"}, {"role": "user", "content": "Edit applied."}, {"role": "assistant", "content": "Applying the fix in fastapi/dependencies/utils.py (hunk at line 472).\n<|tool_call|>{\"name\": \"edit_file\", \"arguments\": {\"path\": \"fastapi/dependencies/utils.py\", \"old_text\": \"        ) or is_uploadfile_sequence_annotation(type_annotation):\\n            field_info = params.File(annotation=use_annotation, default=default_value)\\n        elif not field_annotation_is_scalar(annotation=type_annotation):\\n            if annotation_is_pydantic_v1(use_annotation):\\n                field_info = temp_pydantic_v1_params.Body(  # type: ignore[assignment]\\n                    annotation=use_annotation, default=default_value\\n                )\\n            else:\\n                field_info = params.Body(\\n                    annotation=use_annotation, default=default_value\\n                )\\n        else:\\n            field_info = params.Query(annotation=use_annotation, default=default_value)\\n\", \"new_text\": \"        ) or is_uploadfile_sequence_annotation(type_annotation):\\n            field_info = params.File(annotation=use_annotation, default=default_value)\\n        elif not field_annotation_is_scalar(annotation=type_annotation):\\n            field_info = params.Body(annotation=use_annotation, default=default_value)\\n        else:\\n            field_info = params.Query(annotation=use_annotation, default=default_value)\\n\"}}<|tool_call_end|>"}], "metadata": {"source": "programmatic", "instance_id": "fastapi_14609", "repo": "fastapi/fastapi", "base_commit": "1b3bea8b6be2220cc1544653ea785d2134fcb35b", "files": ["docs_src/request_form_models/tutorial002_pv1_an_py39.py", "docs_src/request_form_models/tutorial002_pv1_py39.py", "fastapi/_compat/__init__.py", "fastapi/_compat/main.py", "fastapi/_compat/may_v1.py", "fastapi/_compat/model_field.py", "fastapi/_compat/shared.py", "fastapi/_compat/v1.py", "fastapi/_compat/v2.py", "fastapi/datastructures.py", "fastapi/dependencies/utils.py", "fastapi/encoders.py", "fastapi/exceptions.py", "fastapi/openapi/models.py", "fastapi/openapi/utils.py", "fastapi/param_functions.py", "fastapi/params.py", "fastapi/routing.py", "fastapi/temp_pydantic_v1_params.py", "fastapi/utils.py"], "symbols": ["FormData", "login", "get_cached_model_fields", "_is_undefined"], "n_hunks": 92, "n_files": 20, "stripped_hunks": 0, "lossy_hunks": 0, "test_target": ["tests/test_compat.py", "tests/test_compat_params_v1.py"], "test_target_source": "test_patch", "synthesized": {"graph_observations": true, "repro_observations": true, "test_observations": true, "read_observations": "snapshot", "reasoning_text": true, "repro_script": "generic"}, "note": "Programmatic replay of the reference patch; graph/repro/test observations are synthesized from patch context, not live tool outputs. Read-file observations are snapshot.", "turns": 104, "generator": "gen_programmatic.py v1", "traj_turn": 38, "tool": "edit_file", "est_tokens": 1518, "split_from": "fastapi_14609"}}
