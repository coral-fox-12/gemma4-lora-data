ddd1\ufe0f Deprecate `ORJSONResponse` and `UJSONResponse`\r\n\r\nNow that there's better performance by default, with response models: https://github.com/fastapi/fastapi/pull/14962\r\n\r\nThis removes `ujson` and `orjson` from the `\"fastapi[all]\"` extras.\r\n\r\nTo use these responses, `ujson` or `orjson` need to be explicitly installed."}, {"role": "assistant", "content": "Reading fastapi/responses.py around the suspect symbol.\n<|tool_call|>{\"name\": \"read_file\", \"arguments\": {\"path\": \"fastapi/responses.py\"}}<|tool_call_end|>"}, {"role": "user", "content": "fastapi/responses.py (lines 1-48 of 48):\n1| from typing import Any\n2| \n3| from starlette.responses import FileResponse as FileResponse  # noqa\n4| from starlette.responses import HTMLResponse as HTMLResponse  # noqa\n5| from starlette.responses import JSONResponse as JSONResponse  # noqa\n6| from starlette.responses import PlainTextResponse as PlainTextResponse  # noqa\n7| from starlette.responses import RedirectResponse as RedirectResponse  # noqa\n8| from starlette.responses import Response as Response  # noqa\n9| from starlette.responses import StreamingResponse as StreamingResponse  # noqa\n10| \n11| try:\n12|     import ujson\n13| except ImportError:  # pragma: nocover\n14|     ujson = None  # type: ignore\n15| \n16| \n17| try:\n18|     import orjson\n19| except ImportError:  # pragma: nocover\n20|     orjson = None  # type: ignore\n21| \n22| \n23| class UJSONResponse(JSONResponse):\n24|     \"\"\"\n25|     JSON response using the high-performance ujson library to serialize data to JSON.\n26| \n27|     Read more about it in the\n28|     [FastAPI docs for Custom Response - HTML, Stream, File, others](https://fastapi.tiangolo.com/advanced/custom-response/).\n29|     \"\"\"\n30| \n31|     def render(self, content: Any) -> bytes:\n32|         assert ujson is not None, \"ujson must be installed to use UJSONResponse\"\n33|         return ujson.dumps(content, ensure_ascii=False).encode(\"utf-8\")\n34| \n35| \n36| class ORJSONResponse(JSONResponse):\n37|     \"\"\"\n38|     JSON response using the high-performance orjson library to serialize data to JSON.\n39| \n40|     Read more about it in the\n41|     [FastAPI docs for Custom Response - HTML, Stream, File, others](https://fastapi.tiangolo.com/advanced/custom-response/).\n42|     \"\"\"\n43| \n44|     def render(self, content: Any) -> bytes:\n45|         assert orjson is not None, \"orjson must be installed to use ORJSONResponse\"\n46|         return orjson.dumps(\n47|             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY\n48|         )"}, {"role": "assistant", "content": "Before editing anything, I'll write a small repro script under /tmp that triggers the reported failure.\n<|tool_call|>{\"name\": \"write_file\", \"arguments\": {\"path\": \"/tmp/repro_fastapi_14964.py\", \"content\": \"\\\"\\\"\\\"Repro for fastapi_14964 (programmatic replay; generic script).\\\"\\\"\\\"\\nimport sys\\nsys.path.insert(0, \\\"/workspace\\\")\\n\\nfrom fastapi.responses import UJSONResponse  # noqa: F401\\n\\n# Reported failure (from the issue):\\n# \\ud83d\\uddd1\\ufe0f Deprecate `ORJSONResponse` and `UJSONResponse` \\ud83d\\uddd1\\ufe0f Deprecate `ORJSONResponse` and `UJSONResponse` Now that there's better performance by default, with response models: https://github.com/fastapi/fas...\\n# A faithful repro needs the exact failing call from the issue, so\\n# this script confirms the module imports and the symbol exists;\\n# the failure itself is triggered from the issue's example.\\nprint(\\\"repro ready:\\\", UJSONResponse)\\n\"}}<|tool_call_end|>"}, {"role": "user", "content": "File written."}, {"role": "assistant", "content": "Running the repro to confirm the reported failure.\n<|tool_call|>{\"name\": \"run_command\", \"arguments\": {\"command\": \"python /tmp/repro_fastapi_14964.py\"}}<|tool_call_end|>"}], "metadata": {"source": "programmatic", "instance_id": "fastapi_14964", "repo": "fastapi/fastapi", "base_commit": "bc06e4296d588f39f38c7ac2fc96d3913c565962", "files": ["fastapi/responses.py"], "symbols": ["UJSONResponse", "render", "ORJSONResponse", "deprecated"], "n_hunks": 2, "n_files": 1, "stripped_hunks": 0, "lossy_hunks": 0, "test_target": ["tests/test_deprecated_responses.py", "tests/test_orjson_response_class.py"], "test_target_source": "test_patch", "synthesized": {"graph_observations": true, "repro_observations": true, "test_observations": true, "read_observations": "snapshot", "reasoning_text": true, "repro_script": "generic"}, "note": "Programmatic replay of the reference patch; graph/repro/test observations are synthesized from patch context, not live tool outputs. Read-file observations are snapshot.", "turns": 12, "generator": "gen_programmatic.py v1", "traj_turn": 5, "tool": "run_command", "est_tokens": 1846, "split_from": "fastapi_14964"}}
