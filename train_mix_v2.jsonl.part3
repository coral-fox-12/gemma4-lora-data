on_alias: Union[str, None] = None,\\n        title: Optional[str] = None,\\n        description: Optional[str] = None,\", \"new_text\": \"        media_type: str = \\\"application/x-www-form-urlencoded\\\",\\n        alias: Optional[str] = None,\\n        alias_priority: Union[int, None] = _Unset,\\n        validation_alias: Union[str, AliasPath, AliasChoices, None] = None,\\n        serialization_alias: Union[str, None] = None,\\n        title: Optional[str] = None,\\n        description: Optional[str] = None,\"}}<|tool_call_end|>"}], "metadata": {"source": "programmatic", "instance_id": "fastapi_14609", "repo": "fastapi/fastapi", "base_commit": "1b3bea8b6be2220cc1544653ea785d2134fcb35b", "files": ["docs_src/request_form_models/tutorial002_pv1_an_py39.py", "docs_src/request_form_models/tutorial002_pv1_py39.py", "fastapi/_compat/__init__.py", "fastapi/_compat/main.py", "fastapi/_compat/may_v1.py", "fastapi/_compat/model_field.py", "fastapi/_compat/shared.py", "fastapi/_compat/v1.py", "fastapi/_compat/v2.py", "fastapi/datastructures.py", "fastapi/dependencies/utils.py", "fastapi/encoders.py", "fastapi/exceptions.py", "fastapi/openapi/models.py", "fastapi/openapi/utils.py", "fastapi/param_functions.py", "fastapi/params.py", "fastapi/routing.py", "fastapi/temp_pydantic_v1_params.py", "fastapi/utils.py"], "symbols": ["FormData", "login", "get_cached_model_fields", "_is_undefined"], "n_hunks": 92, "n_files": 20, "stripped_hunks": 0, "lossy_hunks": 0, "test_target": ["tests/test_compat.py", "tests/test_compat_params_v1.py"], "test_target_source": "test_patch", "synthesized": {"graph_observations": true, "repro_observations": true, "test_observations": true, "read_observations": "snapshot", "reasoning_text": true, "repro_script": "generic"}, "note": "Programmatic replay of the reference patch; graph/repro/test observations are synthesized from patch context, not live tool outputs. Read-file observations are snapshot.", "turns": 104, "generator": "gen_programmatic.py v1", "