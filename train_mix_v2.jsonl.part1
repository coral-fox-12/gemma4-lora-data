_end|>"}], "metadata": {"source": "programmatic", "instance_id": "rich_4079", "repo": "Textualize/rich", "base_commit": "19c67b9a3479841e9133bea94607c89ee931d3fc", "files": ["rich/markdown.py"], "symbols": ["__init__", "on_text", "ListElement", "append_text"], "n_hunks": 1, "n_files": 1, "stripped_hunks": 0, "lossy_hunks": 0, "test_target": ["tests/test_markdown.py"], "test_target_source": "test_patch", "synthesized": {"graph_observations": true, "repro_observations": true, "test_observations": true, "read_observations": "snapshot", "reasoning_text": true, "repro_script": "generic"}, "note": "Programmatic replay of the reference patch; graph/repro/test observations are synthesized from patch context, not live tool outputs. Read-file observations are snapshot.", "turns": 11, "generator": "gen_programmatic.py v1", "traj_turn": 3, "tool": "read_file", "est_tokens": 1349, "split_from": "rich_4079"}}
