ustom `FastAPIDeprecationWarning` and use it for deprecated logic, like Pydantic v1 models.\r\n\r\nMotivated by: https://sethmlarson.dev/deprecations-via-warnings-dont-work-for-python-libraries"}, {"role": "assistant", "content": "Applying the fix in fastapi/routing.py (hunk at line 47).\n<|tool_call|>{\"name\": \"edit_file\", \"arguments\": {\"path\": \"fastapi/routing.py\", \"old_text\": \"from fastapi.encoders import jsonable_encoder\\nfrom fastapi.exceptions import (\\n    EndpointContext,\\n    FastAPIError,\\n    RequestValidationError,\\n    ResponseValidationError,\", \"new_text\": \"from fastapi.encoders import jsonable_encoder\\nfrom fastapi.exceptions import (\\n    EndpointContext,\\n    FastAPIDeprecationWarning,\\n    FastAPIError,\\n    RequestValidationError,\\n    ResponseValidationError,\"}}<|tool_call_end|>"}, {"role": "user", "content": "Edit applied."}, {"role": "assistant", "content": "Applying the fix in fastapi/routing.py (hunk at line 641).\n<|tool_call|>{\"name\": \"edit_file\", \"arguments\": {\"path\": \"fastapi/routing.py\", \"old_text\": \"                warnings.warn(\\n                    \\\"pydantic.v1 is deprecated and will soon stop being supported by FastAPI.\\\"\\n                    f\\\" Please update the response model {self.response_model!r}.\\\",\\n                    category=DeprecationWarning,\\n                    stacklevel=4,\\n                )\\n            self.response_field = create_model_field(\", \"new_text\": \"                warnings.warn(\\n                    \\\"pydantic.v1 is deprecated and will soon stop being supported by FastAPI.\\\"\\n                    f\\\" Please update the response model {self.response_model!r}.\\\",\\n                    category=FastAPIDeprecationWarning,\\n                    stacklevel=4,\\n                )\\n            self.response_field = create_model_field(\"}}<|tool_call_end|>"}, {"role": "user", "content": "Edit applied."}, {"role": "assistant", "content": "Applying the fix in fastapi/routing.py (hunk at line 681).\n<|tool_call|>{\"name\": \"edit_file\", \"arguments\": {\"path\": \"fastapi/routing.py\", \"old_text\": \"                    warnings.warn(\\n                        \\\"pydantic.v1 is deprecated and will soon stop being supported by FastAPI.\\\"\\n                        f\\\" In responses={{}}, please update {model}.\\\",\\n                        category=DeprecationWarning,\\n                        stacklevel=4,\\n                    )\\n                response_field = create_model_field(\", \"new_text\": \"                    warnings.warn(\\n                        \\\"pydantic.v1 is deprecated and will soon stop being supported by FastAPI.\\\"\\n                        f\\\" In responses={{}}, please update {model}.\\\",\\n                        category=FastAPIDeprecationWarning,\\n                        stacklevel=4,\\n                    )\\n                response_field = create_model_field(\"}}<|tool_call_end|>"}, {"role": "user", "content": "Edit applied."}, {"role": "assistant", "content": "Applying the fix in fastapi/temp_pydantic_v1_params.py (hunk at line 1).\n<|tool_call|>{\"name\": \"edit_file\", \"arguments\": {\"path\": \"fastapi/temp_pydantic_v1_params.py\", \"old_text\": \"import warnings\\nfrom typing import Annotated, Any, Callable, Optional, Union\\n\\nfrom fastapi.openapi.models import Example\\nfrom fastapi.params import ParamTypes\\nfrom typing_extensions import deprecated\", \"new_text\": \"import warnings\\nfrom typing import Annotated, Any, Callable, Optional, Union\\n\\nfrom fastapi.exceptions import FastAPIDeprecationWarning\\nfrom fastapi.openapi.models import Example\\nfrom fastapi.params import ParamTypes\\nfrom typing_extensions import deprecated\"}}<|tool_call_end|>"}, {"role": "user", "content": "Edit applied."}, {"role": "assistant", "content": "Applying the fix in fastapi/temp_pydantic_v1_params.py (hunk at line 64).\n<|tool_call|>{\"name\": \"edit_file\", \"arguments\": {\"path\": \"fastapi/temp_pydantic_v1_params.py\", \"old_text\": \"        if example is not _Unset:\\n            warnings.warn(\\n                \\\"`example` has been deprecated, please use `examples` instead\\\",\\n                category=DeprecationWarning,\\n                stacklevel=4,\\n            )\\n        self.example = example\", \"new_text\": \"        if example is not _Unset:\\n            warnings.warn(\\n                \\\"`example` has been deprecated, please use `examples` instead\\\",\\n                category=FastAPIDeprecationWarning,\\n                stacklevel=4,\\n            )\\n        self.example = example\"}}<|tool_call_end|>"}], "metadata": {"source": "programmatic", "instance_id": "fastapi_14605", "repo": "fastapi/fastapi", "base_commit": "6b53786f626db95a42fd0f66afd360bab161f4b1", "files": ["fastapi/dependencies/utils.py", "fastapi/exceptions.py", "fastapi/openapi/utils.py", "fastapi/params.py", "fastapi/routing.py", "fastapi/temp_pydantic_v1_params.py", "fastapi/utils.py"], "symbols": ["get_dependant", "__init__", "FastAPIDeprecationWarning", "generate_operation_id"], "n_hunks": 20, "n_files": 7, "stripped_hunks": 0, "lossy_hunks": 0, "test_target": ["tests/benchmarks/test_general_performance.py", "tests/test_compat_params_v1.py"], "test_target_source": "test_patch", "synthesized": {"graph_observations": true, "repro_observations": true, "test_observations": true, "read_observations": "snapshot", "reasoning_text": true, "repro_script": "generic"}, "note": "Programmatic replay of the reference patch; graph/repro/test observations are synthesized from patch context, not live tool outputs. Read-file observations are snapshot.", "turns": 32, "generator": "gen_programmatic.py v1", "traj_turn": 22, "tool": "edit_file", "est_tokens": 1995, "split_from": "fastapi_14605"}}
