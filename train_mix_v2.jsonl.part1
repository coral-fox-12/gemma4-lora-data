2\tdef _cleanup_unused_links(self, all_stages):\n    13\t    used = [\n    14\t        out.fspath\n    15\t        for stage in all_stages\n    16\t        for out in stage.outs\n    17\t        if out.scheme == \"local\"\n    18\t    ]\n    19\t    self.state.remove_unused_links(used)\n    20\t\n    21\t\n    22\tdef get_all_files_numbers(stages):\n    23\t    return sum(stage.get_all_files_number() for stage in stages)\n    24\t\n    25\t\n    26\tdef get_progress_callback(stages):\n    27\t    total_files_num = get_all_files_numbers(stages)\n    28\t    if total_files_num == 0:\n    29\t        return None\n    30\t    return ProgressCallback(total_files_num)\n    31\t\n    32\t\n    33\tdef checkout(self, target=None, with_deps=False, force=False, recursive=False):\n    34\t    from dvc.stage import StageFileDoesNotExistError, StageFileBadNameError\n    35\t\n    36\t    all_stages = self.stages()\n    37\t\n    38\t    try:\n    39\t        stages = self.collect(target, with_deps=with_deps, recursive=recursive)\n    40\t    except (StageFileDoesNotExistError, StageFileBadNameError) as exc:\n    41\t        if not target:\n    42\t            raise\n    43\t        raise CheckoutErrorSuggestGit(target, exc)\n    44\t\n    45\t    with self.state:\n    46\t        _cleanup_unused_links(self, all_stages)\n    47\t        progress_callback = get_progress_callback(stages)\n    48\t\n    49\t        for stage in stages:\n    50\t            if stage.locked:\n    51\t                logger.warning(\n    52\t                    \"DVC-file '{path}' is locked. Its dependencies are\"\n    53\t                    \" not going to be checked out.\".format(path\n[... observation truncated ...]"}, {"role": "assistant", "content": "Let's also look at the stage implementation since it's doing the actual checkout:\n<|tool_call|>{\"name\": \"read_file\", \"arguments\": {\"path\": \"/workspace/iterative__dvc__0.50/dvc/stage.py\"}}<|tool_call_end|>"}], "metadata": {"source": "swegym